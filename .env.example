# Copy to .env and edit as needed. docker compose reads .env automatically;
# it is not committed to version control (see .gitignore).

# Port the server listens on, and the host port it's published to.
HCDB_PORT=6380

# Directory inside the container where the WAL and SSTables are stored.
HCDB_DATA_DIR=/data

# Container resource limits.
HCDB_MEM_LIMIT=4g
HCDB_CPUS=2.0
